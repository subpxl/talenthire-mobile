rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function isPremium() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('subscription_status', 'free') == 'premium';
    }

    function stringField(data, field, maxLen) {
      return field in data
        && data[field] is string
        && data[field].size() <= maxLen;
    }

    function optionalString(data, field, maxLen) {
      return !(field in data) || stringField(data, field, maxLen);
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function conversationExists(convId) {
      return exists(/databases/$(database)/documents/conversations/$(convId));
    }

    function conversationParticipants(convId) {
      return get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
    }

    function isConversationParticipant(convId) {
      return isSignedIn()
        && conversationExists(convId)
        && request.auth.uid in conversationParticipants(convId);
    }

    // ── users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();

      // Clients may only create their own influencer account.
      // role/admin can be granted only by Admin SDK / console.
      allow create: if isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.role == 'influencer'
        && request.resource.data.get('is_active', true) == true
        && stringField(request.resource.data, 'name', 80)
        && stringField(request.resource.data, 'email', 254)
        && optionalString(request.resource.data, 'mobile', 20);

      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.id == userId
        && !changedKeys().hasAny(['role', 'is_active', 'id', 'created_at'])
        && changedKeys().hasOnly([
          'name',
          'email',
          'mobile',
          'birth_day',
          'birth_month',
          'birth_year',
          'updated_at',
          'fcm_tokens'
        ])
        && optionalString(request.resource.data, 'name', 80)
        && optionalString(request.resource.data, 'email', 254)
        && optionalString(request.resource.data, 'mobile', 20)
      );

      allow delete: if false;
    }

    // ── profiles (influencer profiles) ─────────────────────────────────────
    match /profiles/{userId} {
      allow read: if isSignedIn();

      allow create: if isOwner(userId)
        && request.resource.data.user_id == userId
        && request.resource.data.subscription_status == 'free'
        && request.resource.data.get('is_verified', false) == false
        && request.resource.data.get('account_status', 'active') == 'active'
        && request.resource.data.get('free_job_applications_used', 0) == 0
        && optionalString(request.resource.data, 'bio', 2000)
        && optionalString(request.resource.data, 'contact', 40);

      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.user_id == userId
        && !changedKeys().hasAny([
          'subscription_status',
          'is_verified',
          'account_status',
          'free_job_applications_used',
          'user_id'
        ])
        && optionalString(request.resource.data, 'bio', 2000)
        && optionalString(request.resource.data, 'contact', 40)
      );

      allow delete: if false;
    }

    // ── saved jobs (per user subcollection) ─────────────────────────────────
    match /users/{userId}/saved_jobs/{jobId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/saved_creators/{creatorId} {
      allow read, write: if isOwner(userId);
    }

    // ── conversations ──────────────────────────────────────────────────────
    match /conversations/{convId} {
      function isParticipant() {
        return isConversationParticipant(convId);
      }

      allow read: if isAdmin() || isParticipant();

      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.resource.data.participants[0].size() > 0
        && request.resource.data.participants[0].size() <= 128
        && request.resource.data.participants[1].size() > 0
        && request.resource.data.participants[1].size() <= 128;

      allow update: if isParticipant()
        && request.resource.data.participants == resource.data.participants
        && !changedKeys().hasAny(['participants']);

      allow delete: if false;
    }

    // ── messages ───────────────────────────────────────────────────────────
    match /messages/{msgId} {
      allow read: if isAdmin() || (
        isSignedIn()
        && 'conversation_id' in resource.data
        && isConversationParticipant(resource.data.conversation_id)
      );

      allow create: if isSignedIn()
        && request.resource.data.sender_id == request.auth.uid
        && stringField(request.resource.data, 'conversation_id', 128)
        && isConversationParticipant(request.resource.data.conversation_id)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;

      allow update, delete: if false;
    }

    // ── jobs (Admin SDK / console only — not client-writable) ──────────────
    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── applications ───────────────────────────────────────────────────────
    match /applications/{appId} {
      allow read: if isAdmin() || (
        isSignedIn() && resource.data.user_id == request.auth.uid
      );

      // Only the signed-in premium owner can create their own application.
      allow create: if isPremium()
        && request.resource.data.user_id == request.auth.uid
        && appId == request.auth.uid + '_' + request.resource.data.job_id
        && request.resource.data.status == 'applied'
        && exists(/databases/$(database)/documents/jobs/$(request.resource.data.job_id))
        && stringField(request.resource.data, 'job_id', 128)
        && stringField(request.resource.data, 'job_title', 200)
        && optionalString(request.resource.data, 'company', 120);

      // Status changes are admin-only. Clients cannot rewrite applications.
      allow update: if isAdmin()
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.job_id == resource.data.job_id;

      allow delete: if false;
    }

    // ── notifications ──────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ── reports (admin moderation) ─────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && optionalString(request.resource.data, 'reason', 500)
        && optionalString(request.resource.data, 'details', 2000);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── settings (talent categories, etc.) ─────────────────────────────────
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ── subscriptions (Cashfree billing — server writes only) ─────────────
    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ── account deletion requests (public web form) ───────────────────────
    match /account_deletion_requests/{requestId} {
      allow create: if request.resource.data.keys().hasAll([
            'fullName',
            'email',
            'accountType',
            'status',
            'createdAt'
          ])
          && request.resource.data.fullName is string
          && request.resource.data.fullName.size() > 0
          && request.resource.data.fullName.size() <= 120
          && request.resource.data.email is string
          && request.resource.data.email.matches('.*@.*\\..*')
          && request.resource.data.email.size() <= 254
          && request.resource.data.accountType in ['artist', 'agency']
          && request.resource.data.status == 'pending';
      allow read, update, delete: if false;
    }
  }
}

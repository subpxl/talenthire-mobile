rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function stringField(data, field, maxLen) {
      return field in data
        && data[field] is string
        && data[field].size() <= maxLen;
    }

    function optionalString(data, field, maxLen) {
      return !(field in data) || stringField(data, field, maxLen);
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function conversationExists(convId) {
      return exists(/databases/$(database)/documents/conversations/$(convId));
    }

    function conversationParticipants(convId) {
      return get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
    }

    function isConversationParticipant(convId) {
      return isSignedIn()
        && conversationExists(convId)
        && request.auth.uid in conversationParticipants(convId);
    }

    function isAgency() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'agency';
    }

    function applicationJobId(data) {
      return data.get('job_id', data.get('jobId', ''));
    }

    function agencyOwnsJob(jobId) {
      return isAgency()
        && jobId is string
        && jobId.size() > 0
        && jobId.size() <= 128
        && exists(/databases/$(database)/documents/jobs/$(jobId))
        && (
          get(/databases/$(database)/documents/jobs/$(jobId)).data.get('agencyId', '')
            == request.auth.uid
          || get(/databases/$(database)/documents/jobs/$(jobId)).data.get('created_by', '')
            == request.auth.uid
        );
    }

    // ── users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isAdmin() || (isOwner(userId) && (
        (
          request.resource.data.role == 'influencer'
          && request.resource.data.id == userId
          && request.resource.data.get('is_active', true) == true
          && !('registration_reminders' in request.resource.data)
          && stringField(request.resource.data, 'name', 80)
          && stringField(request.resource.data, 'email', 254)
          && optionalString(request.resource.data, 'mobile', 20)
          && optionalString(request.resource.data, 'referred_by_code', 64)
        )
        || (
          request.resource.data.role == 'agency'
          && request.resource.data.uid == userId
          && request.resource.data.ownerId == userId
          && !('registration_reminders' in request.resource.data)
          && stringField(request.resource.data, 'email', 254)
          && stringField(request.resource.data, 'agencyName', 120)
          && stringField(request.resource.data, 'profileDetails', 2000)
        )
      ));

      allow update: if isAdmin() || (
        isOwner(userId)
        && resource.data.role == 'agency'
        && request.resource.data.role == 'agency'
        && request.resource.data.uid == userId
        && request.resource.data.ownerId == resource.data.ownerId
        && !changedKeys().hasAny(['role', 'uid', 'ownerId', 'registration_reminders'])
      ) || (
        isOwner(userId)
        && request.resource.data.id == userId
        && !changedKeys().hasAny([
          'role',
          'is_active',
          'id',
          'created_at',
          'registration_reminders',
          'referred_by_code'
        ])
        && changedKeys().hasOnly([
          'name',
          'email',
          'mobile',
          'birth_day',
          'birth_month',
          'birth_year',
          'updated_at',
          'fcm_tokens',
          'onboarding_completed',
          'onboarding_step'
        ])
        && optionalString(request.resource.data, 'name', 80)
        && optionalString(request.resource.data, 'email', 254)
        && optionalString(request.resource.data, 'mobile', 20)
        && (!('onboarding_completed' in request.resource.data)
          || request.resource.data.onboarding_completed is bool)
        && (!('onboarding_step' in request.resource.data)
          || (request.resource.data.onboarding_step is string
            && request.resource.data.onboarding_step.size() <= 20
            && request.resource.data.onboarding_step in [
              'mobile', 'language', 'photo', 'done'
            ]))
      ) || (
        // Self-deactivate / reactivate: only is_active (+ updated_at).
        isOwner(userId)
        && changedKeys().hasOnly(['is_active', 'updated_at'])
        && request.resource.data.is_active is bool
      );

      allow delete: if isAdmin();
    }

    // ── profiles (influencer profiles) ─────────────────────────────────────
    match /profiles/{userId} {
      allow read: if isSignedIn();

      allow create: if isAdmin() || (isOwner(userId)
        && request.resource.data.user_id == userId
        && request.resource.data.subscription_status == 'free'
        && request.resource.data.get('is_verified', false) == false
        && request.resource.data.get('account_status', 'active') == 'active'
        && request.resource.data.get('free_job_applications_used', 0) == 0
        && optionalString(request.resource.data, 'bio', 2000)
        && optionalString(request.resource.data, 'contact', 40));

      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.user_id == userId
        && !changedKeys().hasAny([
          'subscription_status',
          'is_verified',
          'account_status',
          'free_job_applications_used',
          'user_id'
        ])
        && optionalString(request.resource.data, 'bio', 2000)
        && optionalString(request.resource.data, 'contact', 40)
      );

      allow delete: if isAdmin();
    }

    // ── saved jobs (per user subcollection) ─────────────────────────────────
    match /users/{userId}/saved_jobs/{jobId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/saved_creators/{creatorId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/saved_talent/{talentId} {
      allow read, write: if isOwner(userId);
    }

    // ── conversations ──────────────────────────────────────────────────────
    match /conversations/{convId} {
      function isParticipant() {
        return isSignedIn()
          && request.auth.uid in resource.data.participants;
      }

      // resource.data (not get()) so array-contains list queries are allowed.
      allow read: if isAdmin() || isParticipant();

      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.resource.data.participants[0].size() > 0
        && request.resource.data.participants[0].size() <= 128
        && request.resource.data.participants[1].size() > 0
        && request.resource.data.participants[1].size() <= 128;

      allow update: if isParticipant()
        && request.resource.data.participants == resource.data.participants
        && !changedKeys().hasAny(['participants']);

      allow delete: if false;
    }

    // ── messages ───────────────────────────────────────────────────────────
    match /messages/{msgId} {
      allow read: if isAdmin() || (
        isSignedIn()
        && 'conversation_id' in resource.data
        && isConversationParticipant(resource.data.conversation_id)
      );

      allow create: if isSignedIn()
        && request.resource.data.sender_id == request.auth.uid
        && stringField(request.resource.data, 'conversation_id', 128)
        && isConversationParticipant(request.resource.data.conversation_id)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;

      allow update, delete: if false;
    }

    // ── jobs ───────────────────────────────────────────────────────────────
    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        || (
          isAgency()
          && request.resource.data.agencyId == request.auth.uid
          && request.resource.data.created_by == request.auth.uid
          && stringField(request.resource.data, 'title', 200)
        );
      allow update: if isAdmin() || (
        isAgency()
        && resource.data.agencyId == request.auth.uid
        && request.resource.data.agencyId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // ── applications ───────────────────────────────────────────────────────
    match /applications/{appId} {
      allow read: if isAdmin() || (
        isSignedIn() && resource.data.user_id == request.auth.uid
      ) || (
        isAgency() && (
          resource.data.get('agency_id', '') == request.auth.uid
          || agencyOwnsJob(applicationJobId(resource.data))
        )
      );

      // Applications must be created via the submitJobApplication callable
      // so apply quota (3/day for 3 days) is enforced server-side.
      allow create: if isAdmin();

      allow update: if isAdmin() || (
        isAgency()
        && agencyOwnsJob(applicationJobId(resource.data))
        && applicationJobId(request.resource.data) == applicationJobId(resource.data)
        && request.resource.data.user_id == resource.data.user_id
        && (
          changedKeys().hasOnly(['status', 'updated_at'])
          || (
            changedKeys().hasOnly([
              'recruiter_note',
              'recruiterNote',
              'fit_status',
              'fitStatus',
              'updated_at'
            ])
            && !('recruiter_note' in request.resource.data)
            && !('recruiterNote' in request.resource.data)
            && !('fit_status' in request.resource.data)
            && !('fitStatus' in request.resource.data)
          )
        )
      ) || (
        isSignedIn()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.job_id == resource.data.job_id
        && appId == request.auth.uid + '_' + resource.data.job_id
        && (
          (
            changedKeys().hasOnly(['youtube_short_url'])
            && stringField(request.resource.data, 'youtube_short_url', 500)
            && !(resource.data.status in ['withdrawn', 'rejected'])
          )
          || (
            changedKeys().hasOnly(['status'])
            && resource.data.status in ['applied', 'opened', 'shortlisted', 'interview']
            && request.resource.data.status == 'withdrawn'
          )
        )
      );

      allow delete: if false;
    }

    // Agency-only application notes (recruiter notes, fit rating) — not visible to talent.
    match /application_agency_meta/{appId} {
      function linkedApplication() {
        return get(/databases/$(database)/documents/applications/$(appId)).data;
      }

      allow read, write: if isAdmin() || (
        isAgency()
        && exists(/databases/$(database)/documents/applications/$(appId))
        && agencyOwnsJob(applicationJobId(linkedApplication()))
      );
    }

    // ── notifications ──────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isAdmin()
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.userId.size() <= 128
        && stringField(request.resource.data, 'title', 200)
        && stringField(request.resource.data, 'body', 2000);

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && changedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;

      allow delete: if false;
    }

    // ── reports (admin moderation) ─────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.type in ['creator', 'job', 'agency', 'conversation']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 128
        && request.resource.data.status == 'pending'
        && request.resource.data.reason in ['spam', 'inappropriate', 'other']
        && optionalString(request.resource.data, 'details', 2000)
        && optionalString(request.resource.data, 'targetLabel', 200);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── settings (talent categories, etc.) ─────────────────────────────────
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ── subscriptions (Cashfree billing — server writes only) ─────────────
    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /transactions/{txnId} {
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.userId == request.auth.uid
          || resource.data.get('user_id', '') == request.auth.uid
        )
      );
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
      allow write: if false;
    }

    // ── affiliate conversions (Kamao webhook audit — server writes only) ──
    match /affiliate_conversions/{bccUserId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── account deletion requests (public web form) ───────────────────────
    match /account_deletion_requests/{requestId} {
      allow create: if request.resource.data.keys().hasAll([
            'fullName',
            'email',
            'accountType',
            'status',
            'createdAt'
          ])
          && request.resource.data.fullName is string
          && request.resource.data.fullName.size() > 0
          && request.resource.data.fullName.size() <= 120
          && request.resource.data.email is string
          && request.resource.data.email.matches('.*@.*\\..*')
          && request.resource.data.email.size() <= 254
          && request.resource.data.accountType in ['artist', 'agency']
          && request.resource.data.status == 'pending';
      allow read, update, delete: if false;
    }
  }
}
